<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SAP API type-library version: 10.0 by default; a 9.3 client builds with -p:SapApiMajor=9 -p:SapApiMinor=3 (see deploy\Build-Client93.ps1) -->
    <SapApiMajor Condition="'$(SapApiMajor)'==''">10</SapApiMajor>
    <SapApiMinor Condition="'$(SapApiMinor)'==''">0</SapApiMinor>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EInvGstAddon.UI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EInvGstAddon.Common\EInvGstAddon.Common.csproj" />
    <ProjectReference Include="..\EInvGstAddon.Core\EInvGstAddon.Core.csproj" />
    <ProjectReference Include="..\EInvGstAddon.ERPNext\EInvGstAddon.ERPNext.csproj" />
    <ProjectReference Include="..\EInvGstAddon.Database\EInvGstAddon.Database.csproj" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <Reference Include="System.Net.Http" />
    <!-- SAP Business One UI API 10.0 -->
    <COMReference Include="SAPbouiCOM">
      <Guid>{6048236A-956D-498D-A6F1-9C81C13AB6E8}</Guid>
      <VersionMajor>$(SapApiMajor)</VersionMajor>
      <VersionMinor>$(SapApiMinor)</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>
</Project>
