<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SAP API type-library version: 10.0 by default; a 9.3 client builds with -p:SapApiMajor=9 -p:SapApiMinor=3 (see deploy\Build-Client93.ps1) -->
    <SapApiMajor Condition="'$(SapApiMajor)'==''">10</SapApiMajor>
    <SapApiMinor Condition="'$(SapApiMinor)'==''">0</SapApiMinor>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EInvGstAddon.Database</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EInvGstAddon.Common\EInvGstAddon.Common.csproj" />
    <ProjectReference Include="..\EInvGstAddon.Core\EInvGstAddon.Core.csproj" />
    <!-- SAP Business One DI API 10.0 (generated from the installed type library, same GUID as the SDK samples) -->
    <COMReference Include="SAPbobsCOM">
      <Guid>{FC8030BE-F5D2-4B8E-8F92-44228FE30100}</Guid>
      <VersionMajor>$(SapApiMajor)</VersionMajor>
      <VersionMinor>$(SapApiMinor)</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>
</Project>
